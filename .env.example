# Copy this file to .env and fill in the values: cp .env.example .env
# Restart the Vite dev server after changing it.
# Every VITE_ variable is built into the public JavaScript bundle: never put secrets here.

# Base URL of the gokka-backend API, including the /api/v1 prefix.
# Leave it unset to use the relative path /api/v1 (same domain as the site, e.g. behind nginx).
VITE_API_URL=http://localhost:4000/api/v1
